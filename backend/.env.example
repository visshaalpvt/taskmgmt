# ─── Supabase ─────────────────────────────────────────────────────────
# Your Supabase project URL (e.g. https://oktdrgfsobysdexwghsw.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key (from Supabase Dashboard → Project Settings → API)
# ⚠️  NEVER commit this key — it bypasses RLS!
SUPABASE_SERVICE_KEY=your-service-role-secret-key-here

# ─── CORS ─────────────────────────────────────────────────────────────
# Your deployed Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app-name.vercel.app

# ─── Server ───────────────────────────────────────────────────────────
# Render sets PORT automatically — only change for local dev
PORT=3001
